# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Sem estas variáveis, o app roda com backend em memória (bom para testes locais).
#
# Onde achar no Supabase: Project Settings > API
#  - Project URL          -> NEXT_PUBLIC_SUPABASE_URL
#  - Project API keys > service_role (secret) -> SUPABASE_SERVICE_ROLE_KEY  (NUNCA exponha no cliente)

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Senha da página dos Funcionários (área restrita). Se não definir, usa um padrão no código.
RECEPCAO_PASSWORD=

# Código de presença embutido no QR da parede. Só entra na fila quem escaneia o QR.
# Se não definir, usa um padrão no código. Troque para invalidar QRs antigos.
CHECKIN_TOKEN=
